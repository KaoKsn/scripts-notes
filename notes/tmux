-- Tmux sessions keep running unless killed.
-- So, if you SSH into a system and run update command in a tmux session
-- Even if you lose the SSH connection
-- Updations/Processes inside the tmux session continue.
-- The Tmux session ends when the server shuts down or if you manually close the session.

-- Session > Window > Pane.
-- A window can contain many panes.
-- A single session can contain many windows.

<C-b> - Prefix key, to let tmux know that we are interested in giving a command to tmux.

tmux - to run a tmux session

pkey followed by d(detach) - puts the tmux session on background.

tmux list-sessions - to list all the windows.
tmux ls
0: 1 windows (created Wed Oct 22 00:32:32 2025)

-- Default session names are non-negative integers. 
tmux rename-session <session-name> [When in Bash inside the session].

tmux attach - to attach to the lastest closed session.
tmux a
tmux attach -t[target] sessionID - attach to the session with a specified sessionID.

-- Panes.
pkey arrow-direction - move to the pane in the arrow-direction.

pkey x - kill a tmux pane.

-- Windows
-- * points at the current working window.
-- Windows are independent.
-- Window ID assigned when the window is created*
tmux new-window - create a new window. [When in Bash]

pkey c - create a new window.

-- Splits.
pkey % - vertically split the window.
pkey " - horizontally split the window.

-- Previous and Next wrap automatically.
pkey p - move to the previous window.
pkey n - move to the next window.

pkey & - kill the window.

pkey , - rename a window.
tmux rename-window <new name> [When in Bash].


-- Configuring tmux.
~/.tmux.conf
# A simple Tmux configuration file.

# C - Ctrl
# S - Shift
# M - Alt

# Config reload <prefix r - reloads the source file>
  bind-key r source-file ~/.tmux.conf \; display-message "tmux.conf relaoded!"

# Prefix key(s).
  set-option -g prefix C-f
  set-option -g prefix2 C-b # Default.

# Mouse Mode
# Use the mouse to dynamically resize pane size.
# Use the mouse to move focus to any selected pane.
  set -g mouse on

# Spliting window made easy.
  bind-key v split-window -h
  bind-key h split-window -v
# Defaults
# bind-key % split-window -h
# bind-key " split-window -v

# Using arrow keys to switch between panes.
  bind -n Left select-pane -L
  bind -n Down select-pane -D
  bind -n Up select-pane -U
  bind -n Right select-pane -R

# Pane Synchronization.
  bind-key y set-window-option synchronize-panes \; display-message "Pane Synchronization Toggled!"


-- Command mode.
pkey : - Enter the command mode.
  set -g mouse off - Turns mouse mode off for the current tmux session. 
