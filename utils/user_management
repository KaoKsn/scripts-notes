-- Linux User Management.
-- Requires sudo permissions.

/home/ - contains the home directory of any user.
Groups - username wheel docker [many others, each user has a group named after his username ]

-- Binaries:
/usr/bin/gpasswd
/usr/bin/groupadd
/usr/bin/passwd
/usr/bin/useradd
/usr/bin/userdel
/usr/bin/usermod

-- Man pages.
man binary_name

useradd -m username - Create a user and add a home directory to the user in /home/

passwd username - Set the password for the user with username 'foo'.

usermod -a[append] -G[groupName] group_name username - Append user to a group without removing him from the existing ones.

gpasswd -d username group_name - Remove a user from a sepcified group.

userdel -r username - Removes a user and his home and spool directories.

usermod -d path_to_new_home_dir user - Change the home_dir of the user.

usermod -d path_to_new_home_dir -m[move contents of home dir] username - New home dir must exist.
Change the ownership of the new_home_dir afterwards.
