NGINX - Reverse Proxy, Load Balancer, Web Server.
    Documentation @(https://nginx.org/en/docs)

Binary Installation (/usr/bin/nginx)
    sudo pacman -S nginx
    sudo apt install nginx

As a SYSTEMD service
    Unit file:
        /usr/lib/systemd/system/nginx.service

    systemctl (enable|disable|start|stop|restart|status) nginx

    systemctl edit nginx.service
        /etc/systemd/system/nginx.service.d/override.conf
        # Allow 'x' restarts in an interval of 'y' sec before considering the service to have failed.
        StartLimitBurst=x
        StartLimitInterval=y
        Restart=(on-failure|always)     # NOTE: Can cause start-limit-hit

        systemctl reset-failed nginx.service

sudo nginx
sudo nginx -s (reload|stop|quit|reopen)

Configuration files:
    /etc/nginx/nginx.conf
    /etc/nginx/sites-enabled/*
    /etc/nginx/conf.d/*

Log files:
    /var/log/nginx/access.log

PID file:    

/run/nginx.pid - PID of the master process.

Basic configuration:
    Modules configured using directives. (/etc/nginx/modules.d/)

    events {
            worker_processes 1024;
    }
    http directive is a part of the `main` context.
    http { # Context
            types {
                    text/html   html;
                    text/css    css;
            }
            server { # Context
                    listen port;
                    server_name name; # Simple directive.

                    location / { # Block directive
                            root /usr/share/nginx/html;
                            index index.html index.htm;
                    }
            }
    }

Setting NGINX as a proxy server.
    http {
            # Proxy @localhost port 80.
            server {
                    listen 80;
                    server_name subdomain.domain.tld;
                    # server_name localhost;
                    # server_name git.kernel.org;

                    location / {
                            proxy_pass http://localhost:8080;
                            # proxy_pass    protocol://fqdn:port;
                    }
                    location ~ \.(gif|png|jpg|bmp) {
                            root /usr/share/nginx/images;
                    }
                    # Regex is always preceeded with a `~`
            }

            # Proxied server localhost:8080.
            server {
                    listen 8080;
                    server_name localhost;

                    root /usr/share/nginx/html;
                    location / {
                    }
            }
    }

Other directives.
    * Comments included *
    http {
            include /etc/nginx/mime.types;

            include /etc/nginx/sites-enabled;

            access_log  /var/log/nginx/access.log

            location /dir404 {
                alias path_to_dir_that_does_exist;
                http://localhost:port/dir404; - serves index.html present in the path that is set as alias.
            }

            /usr/share/nginx
                    - /usr/share/nginx/git
                        - git.html
                    - index.html
            location /git {
                root /usr/share/nginx;
                try_files /git/git.html /index.html =404;
            }
    }

    user username;

Redirections and Rewrites

    location /tothispath {
            alias /usr/share/nginx/;
    }
    location /redirectthis {
            return 307 /tothispath;
    }
        Now, http://localhost:80/redirectthis serves the index.html inside /usr/share/nginx/

    Rewrites
    rewrite ^/number/(\w+) /count/$1;
    http://localhost/number/9 remains number/9 but you are redirected to the page in context /count/$1


Autoindex and other options
server {
        listen 80;
        server_name localhost;

        # First try serving the request as a file, then as a directory
        # If everything fails, return 404.
        location / {
                try_files $uri $uri/ =404;
                autoindex on;
                autoindex_format (html|json|xml|jsonp);
                autoindex_localtime on;
                autoindex_exact_size off;
        }
}


# Default Server
server {
        listen 80 default_server;
        listen [::]:80 default_server;

        server_name _;

        location / {
                root /var/www/html;
                index index.html index.htm;
        }
}
